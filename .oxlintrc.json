{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc"],
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    ".migrate-dump/**",
    "scripts/**"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true,
        "allowExportNames": ["useListControls", "SENSOR_KINDS", "UI_FONTS", "UI_SCALES", "applyUiVars"]
      }
    ]
  }
}
