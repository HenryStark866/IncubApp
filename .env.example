VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_KEY=

# ── Asesor IA (opcional; si no hay key, usa conocimiento local de incubación) ──
# xAI Grok:
# VITE_XAI_API_KEY=xai-...
# VITE_XAI_MODEL=grok-2-latest
# OpenAI:
# VITE_OPENAI_API_KEY=sk-...
# VITE_OPENAI_MODEL=gpt-4o-mini
# Groq (rápido y económico):
# VITE_GROQ_API_KEY=gsk_...
# VITE_GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Workspace (Gmail, Calendar, Drive, Sheets) ──
# 1) Google Cloud Console → APIs: Gmail, Calendar, Drive, Sheets
# 2) OAuth client ID tipo "Aplicación web"
# 3) Orígenes JS autorizados: http://localhost:5173 y tu dominio Vercel
# 4) URI de redirección: el mismo origen (GIS token client)
# VITE_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com
